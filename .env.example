# Copy to .env (chmod 600) and fill in. Never commit .env.
WB_PORT=8791
WB_BIND=0.0.0.0

WB_DB_NAME=workbench
WB_DB_USER=workbench
WB_DB_PASSWORD=change-me
WB_DB_URL=jdbc:postgresql://127.0.0.1:55432/workbench

# s3 | local
WB_BLOB_BACKEND=s3
WB_BLOB_DIR=./data/blobs
WB_S3_ENDPOINT=http://127.0.0.1:9690
WB_S3_REGION=us-east-1
WB_S3_BUCKET=workbench
WB_S3_PREFIX=
WB_S3_ACCESS_KEY_ID=
WB_S3_SECRET_ACCESS_KEY=
WB_S3_FORCE_PATH_STYLE=true
WB_S3_SSE=
WB_S3_ALLOW_INSECURE=true

WB_FILES_MAX_BYTES=209715200
WB_FILES_QUOTA_BYTES=21474836480
WB_FILES_GC_ENABLED=true
WB_FILES_GC_GRACE_DAYS=7
